{
  "doctype": "DocType",
  "name": "Transplant Log",
  "module": "Organ Donation",
  "naming_rule": "Expression",
  "autoname": "naming_series:",
  "is_submittable": 1,
  "track_changes": 1,
  "title_field": "organ_match",
  "fields": [
    {
      "fieldname": "naming_series",
      "fieldtype": "Select",
      "label": "Series",
      "options": "TL-.YYYY.-.####",
      "default": "TL-.YYYY.-.####",
      "reqd": 1
    },
    {
      "fieldname": "organ_match",
      "fieldtype": "Link",
      "label": "Organ Match",
      "options": "Organ Match",
      "reqd": 1
    },
    {
      "fieldname": "donor",
      "fieldtype": "Link",
      "label": "Donor",
      "options": "Donor",
      "fetch_from": "organ_match.donor",
      "read_only": 1
    },
    {
      "fieldname": "recipient",
      "fieldtype": "Link",
      "label": "Recipient",
      "options": "Recipient",
      "fetch_from": "organ_match.recipient",
      "read_only": 1
    },
    {
      "fieldname": "col_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "organ",
      "fieldtype": "Select",
      "label": "Organ",
      "options": "\nHeart\nLiver\nKidney\nLungs\nPancreas\nIntestine\nCornea\nSkin\nBone Marrow",
      "fetch_from": "organ_match.organ",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "transplant_date",
      "fieldtype": "Datetime",
      "label": "Transplant Date & Time",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "section_team",
      "fieldtype": "Section Break",
      "label": "Surgical Team"
    },
    {
      "fieldname": "transplant_hospital",
      "fieldtype": "Link",
      "label": "Transplant Hospital",
      "options": "Hospital",
      "reqd": 1
    },
    {
      "fieldname": "lead_surgeon",
      "fieldtype": "Data",
      "label": "Lead Surgeon"
    },
    {
      "fieldname": "col_break_2",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "anesthetist",
      "fieldtype": "Data",
      "label": "Anesthetist"
    },
    {
      "fieldname": "operation_duration_hours",
      "fieldtype": "Float",
      "label": "Operation Duration (Hours)"
    },
    {
      "fieldname": "section_outcome",
      "fieldtype": "Section Break",
      "label": "Outcome"
    },
    {
      "fieldname": "outcome",
      "fieldtype": "Select",
      "label": "Outcome",
      "options": "\nSuccessful\nFailed\nOngoing",
      "default": "Ongoing",
      "in_list_view": 1
    },
    {
      "fieldname": "follow_up_date",
      "fieldtype": "Date",
      "label": "Next Follow-up Date"
    },
    {
      "fieldname": "col_break_3",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "rejection_episode",
      "fieldtype": "Check",
      "label": "Rejection Episode Noted"
    },
    {
      "fieldname": "immunosuppression_protocol",
      "fieldtype": "Data",
      "label": "Immunosuppression Protocol"
    },
    {
      "fieldname": "section_notes",
      "fieldtype": "Section Break",
      "label": "Notes"
    },
    {
      "fieldname": "post_op_notes",
      "fieldtype": "Text Editor",
      "label": "Post-operative Notes"
    }
  ],
  "permissions": [
    {
      "role": "Organ Donation Manager",
      "read": 1, "write": 1, "create": 1, "submit": 1, "cancel": 1
    },
    {
      "role": "Transplant Coordinator",
      "read": 1, "write": 1, "create": 1, "submit": 1
    }
  ]
}
