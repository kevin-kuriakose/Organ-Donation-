{
  "doctype": "Web Form",
  "title": "Donor Registration",
  "route": "donor-registration",
  "doc_type": "Donor",
  "introduction_text": "<h3>Register as an Organ Donor</h3><p>Join thousands of donors and give the gift of life. Fill in the form below to register.</p>",
  "success_message": "Thank you for registering! Your Donor ID will be shared via email.",
  "login_required": 0,
  "allow_edit": 1,
  "web_form_fields": [
    {
      "fieldname": "donor_name",
      "fieldtype": "Data",
      "label": "Full Name",
      "reqd": 1
    },
    {
      "fieldname": "date_of_birth",
      "fieldtype": "Date",
      "label": "Date of Birth"
    },
    {
      "fieldname": "gender",
      "fieldtype": "Select",
      "label": "Gender",
      "options": "\nMale\nFemale\nOther"
    },
    {
      "fieldname": "blood_group",
      "fieldtype": "Select",
      "label": "Blood Group",
      "reqd": 1,
      "options": "\nA+\nA-\nB+\nB-\nAB+\nAB-\nO+\nO-"
    },
    {
      "fieldname": "mobile",
      "fieldtype": "Data",
      "label": "Mobile"
    },
    {
      "fieldname": "email",
      "fieldtype": "Data",
      "label": "Email"
    },
    {
      "fieldname": "address",
      "fieldtype": "Small Text",
      "label": "Address"
    },
    {
      "fieldname": "state",
      "fieldtype": "Data",
      "label": "State"
    },
    {
      "fieldname": "aadhaar",
      "fieldtype": "Password",
      "label": "Aadhaar Number"
    }
  ],
  "name": "donor_registration"
}