{
  "doctype": "DocType",
  "name": "Brain Death Certificate",
  "module": "Organ Donation",
  "naming_rule": "Expression",
  "autoname": "naming_series:",
  "is_submittable": 1,
  "track_changes": 1,
  "title_field": "donor",
  "fields": [
    {
      "fieldname": "naming_series",
      "fieldtype": "Select",
      "label": "Series",
      "options": "BDC-.YYYY.-.####",
      "default": "BDC-.YYYY.-.####",
      "reqd": 1
    },
    {
      "fieldname": "donor",
      "fieldtype": "Link",
      "label": "Donor",
      "options": "Donor",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "patient",
      "fieldtype": "Data",
      "label": "Patient Name",
      "fetch_from": "donor.donor_name",
      "read_only": 1
    },
    {
      "fieldname": "hospital",
      "fieldtype": "Link",
      "label": "Hospital",
      "options": "Hospital",
      "reqd": 1
    },
    {
      "fieldname": "col_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "date",
      "fieldtype": "Datetime",
      "label": "Date & Time of Certification",
      "reqd": 1
    },
    {
      "fieldname": "certified_by",
      "fieldtype": "Data",
      "label": "Certified By (Doctor Name)",
      "reqd": 1
    },
    {
      "fieldname": "doctor_registration",
      "fieldtype": "Data",
      "label": "Doctor Registration Number"
    },
    {
      "fieldname": "section_apnea",
      "fieldtype": "Section Break",
      "label": "Apnea Test & Clinical Criteria"
    },
    {
      "fieldname": "apnea_test_done",
      "fieldtype": "Check",
      "label": "Apnea Test Performed"
    },
    {
      "fieldname": "apnea_test_result",
      "fieldtype": "Select",
      "label": "Apnea Test Result",
      "options": "\nPositive (Brain Death Confirmed)\nNegative"
    },
    {
      "fieldname": "second_doctor",
      "fieldtype": "Data",
      "label": "Second Certifying Doctor"
    },
    {
      "fieldname": "col_break_2",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "second_certification_date",
      "fieldtype": "Datetime",
      "label": "Second Certification Date & Time"
    },
    {
      "fieldname": "eeg_done",
      "fieldtype": "Check",
      "label": "EEG Performed"
    },
    {
      "fieldname": "section_notes",
      "fieldtype": "Section Break",
      "label": "Clinical Notes"
    },
    {
      "fieldname": "clinical_notes",
      "fieldtype": "Text Editor",
      "label": "Clinical Notes"
    }
  ],
  "permissions": [
    {
      "role": "Organ Donation Manager",
      "read": 1, "write": 1, "create": 1, "submit": 1, "cancel": 1
    },
    {
      "role": "Transplant Coordinator",
      "read": 1, "write": 1, "create": 1, "submit": 1
    },
    {
      "role": "Hospital Admin",
      "read": 1
    }
  ]
}
